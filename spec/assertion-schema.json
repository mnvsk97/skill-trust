{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-check.dev/schemas/assertion/v0.1.json",
  "title": "skill-check spec file",
  "description": "YAML spec file for validating skill behavior against recorded traces.",
  "type": "object",
  "required": ["version", "suite", "tests"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1",
      "description": "Spec version. Always \"0.1\"."
    },
    "suite": {
      "type": "string",
      "description": "Human-readable suite name."
    },
    "description": {
      "type": "string",
      "description": "Optional description of the test suite."
    },

    "defaults": {
      "type": "object",
      "description": "Default values inherited by all tests unless overridden.",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Default agent name (for record mode)."
        },
        "model": {
          "type": "string",
          "description": "Default model (for record mode)."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Default timeout per test in milliseconds."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Maximum tester-target turns before the test is terminated."
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum API spend per test case in USD."
        },
        "eval_runs": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "How many times each eval test case is run."
        },
        "min_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9,
          "description": "Fraction of eval runs that must pass."
        }
      }
    },

    "skills": {
      "type": "object",
      "description": "Skills under test.",
      "additionalProperties": false,
      "properties": {
        "under_test": {
          "$ref": "#/$defs/skill_declaration"
        }
      }
    },

    "fixtures": {
      "type": "array",
      "description": "Named workspace fixtures available to tests.",
      "items": { "$ref": "#/$defs/fixture" }
    },

    "tests": {
      "type": "array",
      "description": "Ordered list of test cases.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test_case" }
    }
  },

  "$defs": {
    "skill_declaration": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Skill source (e.g. 'github:org/repo', local path)."
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string" },
            "command": { "type": "string" }
          }
        }
      }
    },

    "fixture": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Fixture identifier, referenced by tests."
        },
        "path": {
          "type": "string",
          "description": "Path to fixture directory (relative to suite file)."
        },
        "user_home": {
          "type": "string",
          "description": "Path to a directory mounted as ~/.claude/ in the test container."
        }
      }
    },

    "tester_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona": {
          "type": "string",
          "description": "Natural language persona for the tester agent."
        },
        "model": {
          "type": "string",
          "description": "Model for the tester agent."
        }
      }
    },

    "test_case": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique test identifier."
        },
        "kind": {
          "type": "string",
          "enum": ["install", "activation", "negative_activation", "end_to_end"],
          "description": "Test kind."
        },
        "description": {
          "type": "string",
          "description": "Human-readable test description."
        },
        "prompt": {
          "type": ["string", "null"],
          "description": "Prompt to send to the agent. Null for install tests."
        },
        "workspace_fixture": {
          "type": "string",
          "description": "Fixture ID to use as the working directory."
        },
        "trace": {
          "type": "string",
          "description": "Path to a pre-recorded trace file."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Override default timeout for this test."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Override default max turns for this test."
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Override default max API spend for this test."
        },
        "min_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Override default min eval pass rate for this test."
        },
        "tester": {
          "$ref": "#/$defs/tester_config",
          "description": "Tester agent configuration."
        },

        "should_activate": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills that must activate for this prompt."
        },
        "should_not_activate": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills that must NOT activate for this prompt."
        },
        "discovers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skills that must be discovered after install."
        },

        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Workflow steps that must run, in this order."
        },
        "should_not_run": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Workflow steps that must NOT run."
        },

        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Shell commands that must be executed."
        },
        "dangerous": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Shell commands that must NOT be executed."
        },

        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools that must be invoked."
        },
        "forbidden_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools that must NOT be invoked."
        },

        "creates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that must be created."
        },
        "modifies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that must be modified."
        },
        "deletes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that must be deleted."
        },
        "should_not_create": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that must NOT be created."
        },

        "api_calls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "API operations that must be called."
        },
        "forbidden_api_calls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "API operations that must NOT be called."
        },

        "exit_code": {
          "type": "integer",
          "description": "Expected exit code (for install tests)."
        },
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail", "error", "timeout"],
          "description": "Expected final outcome status."
        },
        "outcome_contains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Strings that should appear in outcome data (soft check, warnings only)."
        },
        "outcome_not_contains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Strings that should NOT appear in outcome data (soft check, warnings only)."
        }
      }
    }
  }
}
